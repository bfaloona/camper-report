{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "camper-report",
	"main": "./dist/worker/index.js",
	"compatibility_date": "2026-08-16",

	// dist/client holds an allowlisted copy of the six files the pages actually
	// request (see scripts/build-assets.mjs). The worker bundle lives in a
	// sibling directory, never inside the served tree, so there is nothing to
	// exclude with .assetsignore and no way a build artifact leaks to a public URL.
	//
	// The binding must be named ASSETS: `wrangler pages functions build` emits a
	// fallthrough that calls env.ASSETS.fetch(request) for any path no function
	// claims, which is how /, /shortlist, and /vehicles.json get served at all.
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},

	// An Access application covers exactly one hostname. Preview URLs would put
	// /shortlist and /api/* on a second hostname the Access app does not name,
	// outside the gate — wrangler turns them on by default, so this must be
	// explicit. /api/* would still fail closed there (no Access JWT means a 401),
	// but an ungated copy of the tool is not worth having for a repo that only
	// ever deploys main. workers_dev is stated for the same reason: it is
	// load-bearing (it is the only hostname there is), not a default to inherit.
	"workers_dev": true,
	"preview_urls": false,

	"kv_namespaces": [
		{
			"binding": "PREFS",
			"id": "4ca243938a5d4211b27d133aff97981a"
		}
	],

	// Neither of these is a secret. Both are already public: request any gated
	// path unauthenticated and Cloudflare's 302 to the login page carries the team
	// domain in the hostname and the AUD tag in the `kid` query parameter, so a
	// plain curl reveals them. They identify which Access application guards this
	// Worker; they grant nothing. Keeping them here rather than in the dashboard
	// makes the config reproducible and removes a manual step that has to be
	// repeated correctly after any variable change.
	//
	// The real secret, ANTHROPIC_API_KEY, is NOT here — it is set with
	// `wrangler secret put` and is never touched by a deploy.
	"vars": {
		"CF_ACCESS_TEAM_DOMAIN": "bfaloona.cloudflareaccess.com",
		"CF_ACCESS_AUD": "a2de4891796b960888685927a457d87a6e2c81047497196e7d40c5242494ed02"
	},

	// Still set, so that dashboard-managed variables this file does not declare
	// survive a deploy rather than being silently deleted.
	"keep_vars": true
}
